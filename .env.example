# Strava OAuth — create an app at https://www.strava.com/settings/api
VITE_STRAVA_CLIENT_ID=
VITE_STRAVA_CLIENT_SECRET=
VITE_STRAVA_REDIRECT_URI=http://localhost:5173/
# CARTO basemaps key (carto.com/basemaps/apikey) for the Light basemap; keys are referrer-
# restricted, so use one that allows localhost for local dev.
VITE_CARTO_API_KEY=
